# ============================================================
# billAgent 环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env，按需填值（.env 已被 .gitignore 排除，切勿提交）
#     Windows : copy .env.example .env
#     WSL/mac : cp .env.example .env
#
# ⚠️ 优先级：**已存在的系统环境变量 > .env**（`load_dotenv()` 不覆盖已有值）。
#     若某项在 shell 里已 export，改 .env 不生效。
#
# ⚠️ 本模板是全量清单（来源：`config/config.py` 的 os.getenv 调用 +
#     `webUI/app.py` / `utils/docker_compose.yml` 的外部变量），标注了默认值。
#     全部留空 = 走「本地 Ollama + 本地确定性渲染」基线，链路仍可跑通（R5 可交付性）。
# ============================================================


# ============================================================
# 一、外部大模型接入（当前落地形态；不配则回退本地 Ollama）
# ============================================================
# 说明：base_url 与 api_key **同时非空**才启用外部通道（见 config.EXTERNAL_LLM_ENABLED）。
# 协议：OpenAI 兼容。已验证组合——智谱 GLM-4-Flash（推荐，非推理模型）。
# 选型提示：优先选**非推理模型**。推理模型的 thinking 会吃满 max_tokens 预算，
#          导致「HTTP 200 但正文为空」；若必须用推理模型，请调大
#          `config.EXTERNAL_BASE_LLM_OPTIONS.max_tokens`。

# 外部 API 基址（示例为智谱；DeepSeek 为 https://api.deepseek.com/v1）
BILLAGENT_EXT_LLM_BASE_URL=

# 外部 API 密钥（⚠️ 敏感，切勿提交）
BILLAGENT_EXT_LLM_API_KEY=

# 编排 Agent 模型名（默认 deepseek-chat；智谱填 glm-4-flash）
BILLAGENT_EXT_ORCH_MODEL=glm-4-flash

# 理财 Agent 模型名（默认 deepseek-chat）
BILLAGENT_EXT_FINANCE_MODEL=glm-4-flash

# 外部调用超时（秒，默认 300）
BILLAGENT_EXT_TIMEOUT=300

# 外部模型上下文窗口（默认 8192；glm-4-flash 为 128k，可调大以放宽容错）
BILLAGENT_EXT_CONTEXT_WINDOW=8192

# 哪些 Agent 走外部（逗号分隔；留空 = 按代码内默认集合）
# 可选值：orchestrator_agent / bill_agent / stat_agent / price_agent / finance_agent
BILLAGENT_EXT_AGENTS=

# 【开关】全部 Agent 强制走外部（默认 0）。=1 时忽略 BILLAGENT_EXT_AGENTS
BILLAGENT_FORCE_EXTERNAL=0

# 【硬开关】封死本地 Ollama 通道（★M22 起**默认 1** —— 本地通道已彻底弃用）。
# =1 时若仍有调用走到本地会**立即抛错**：这是**有意的快速失败**，而非静默降级。
# ⚠️ 因此**必须配置外部 API**（BILLAGENT_EXT_LLM_BASE_URL + BILLAGENT_EXT_LLM_API_KEY），
#    否则 ModelRouter.resolve 会直接抛 RuntimeError（启动即暴露，不留到运行期）。
# 回滚：改为 0 可临时恢复本地兜底（代码与 Provider 均保留，属软弃用）。
BILLAGENT_DISABLE_LOCAL_LLM=1


# ============================================================
# 二、本地模型（Ollama）
# ============================================================
# Ollama 服务地址（容器内应填服务名 ollama；本机默认 127.0.0.1）
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Ollama 上下文窗口（默认 4096，需与模型 num_ctx 对齐）
BILLAGENT_OLLAMA_CONTEXT_WINDOW=4096

# 【开关】启用向量检索（embedding）。=0 时自动降级 BM25（默认 1）
BILLAGENT_EMBEDDING=1


# ============================================================
# 三、MCP 常驻服务
# ============================================================
# 端口基址（默认 8000 → sql_bill=8001 / llm_base=8002 / llm_finance=8003）
BILLAGENT_MCP_PORT=8000

# 【回滚开关】MCP 退回 stdio 短连接模式（默认 0）。
# =1 时跳过常驻服务拉起；代价：每次调用冷启动 26~29s（见 README §8）
BILLAGENT_MCP_STDIO=0


# ============================================================
# 四、沙箱与工具超时
# ============================================================
# MCP 子进程内存硬上限 MB（默认 2048；单 server 常驻峰值约 200~400MB）
BILLAGENT_SANDBOX_MEMORY_MB=2048

# 工具级超时（秒）：SQL 默认 30 / LLM 默认 300。≤0 = 关闭超时（M4 回滚要求）
BILLAGENT_TOOL_TIMEOUT_SQL=30
BILLAGENT_TOOL_TIMEOUT_LLM=300


# ============================================================
# 五、任务调度（Durable / 多任务派发）
# ============================================================
# 重启时 submitted 任务的「过期阈值」秒数（默认 1800）。
# 超过该时长的遗留任务视为测试/演示脏数据 → 标 failed，不再重投
# （否则每次启动都会真调 LLM / 真写账）
BILLAGENT_REQUEUE_STALE_AFTER=1800

# 调度轮次上限（默认 8，按波次递增；防编排器回环无限转）
BILLAGENT_MAX_DISPATCH_ROUND=8

# 【A/B 开关】动态依赖（默认 1）。=0 退回纯静态依赖表
BILLAGENT_DYNAMIC_DEPS=1

# 【A/B 开关】批量派发（默认 1）。=0 退回单派发（一次一个），用于测量 ΣT vs max(T)
BILLAGENT_BATCH_DISPATCH=1

# 追问轮次上限（默认 3）；达上限直接放弃并报错，不再追问
BILLAGENT_ASK_ROUND_LIMIT=3


# ============================================================
# 六、账单改删 / FA 自主循环（M15）
# ============================================================
# 【回滚开关】子层自主循环（默认 1）。=0 时 bill_agent 不走 tool loop，
# 退回「确定性目标消解」——**功能不丢**，工具层与注册保持不变
BILLAGENT_BILL_FC=1

# 自主循环最大轮次（默认 4，防模型无限试探）
BILLAGENT_FC_MAX_TURNS=4

# 自然语言指代窗口：用户"刚才那笔"只能指代最近 N 笔（默认 3）
BILLAGENT_RECENT_BILL_WINDOW=3

# 模型可见的账单清单上限（默认 20，防一次拉全表撑爆上下文预算）
BILLAGENT_RECENT_BILL_MAX=20

# UI 账单面板展示条数（默认 20）；与 RECENT_BILL_WINDOW 是**两个数**
BILLAGENT_UI_BILL_PANEL_LIMIT=20

# UI 面板取数上限（默认 200，只读展示用，模型不可见）
BILLAGENT_UI_BILL_FETCH_LIMIT=200


# ============================================================
# 七、用户文档库（RAG）
# ============================================================
# 检索返回条数（默认 3）
BILLAGENT_USER_DOCS_TOP_K=3

# 文档数上限（默认 1000；超出明确报错，不静默截断）
BILLAGENT_USER_DOCS_MAX_DOCS=1000

# 超长行硬切长度（默认 128，分块用）
BILLAGENT_USER_DOCS_CHUNK_SIZE=128

# 文档操作超时秒数（默认 60；⚠️ 当前为预留，独立超时未接线）
BILLAGENT_USER_DOCS_TIMEOUT=60


# ============================================================
# 八、可观测
# ============================================================
# 【开关】链路追踪（默认 1）。=0 关闭 span 落库；
# Tracer 内部异常自行吞掉，最坏只是统计缺失，不影响业务返回
BILLAGENT_TRACER_ENABLED=1


# ============================================================
# 九、运行环境（一般无需修改，容器/测试场景由脚本自动注入）
# ============================================================
# ⚠️ 生产必需：让 localhost 调用绕过系统代理。
# 缺失会导致 httpx 连 127.0.0.1:8001/8002/8003 的 MCP 服务时走 proxy_request 而全部失败
# （踩坑记录见设计 `07`；曾导致评测脚本 MCP 健康检查 120s 探活超时）。
# 已由 `config/config.py` 统一 setdefault —— 凡 import config 的进程自动生效，
#   无需各入口分别手写。此处保留仅为**自定义代理白名单**（如需追加其它直连地址）。
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# Windows 下日志中文编码（start_webui.bat / main.py 已内置，一般无需手动设）
PYTHONIOENCODING=utf-8

# Redis 会话存储（⚠️ **当前代码未接线**：short_memory 为进程内 dict 实现，
#   memory/redis_client.py 为空文件；以下仅为将来切换外部会话存储的预留位，
#   填写不会改变当前行为）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
